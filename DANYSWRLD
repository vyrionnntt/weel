-- Anti Lag Button
PlayerTab:CreateButton({
    Name = "Anti Lag",
    Callback = function()
        pcall(function()
            -- 1. Remover/Simplificar Efeitos Visuais do Ambiente (Lighting)
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9

            for _, v in pairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
                    v.Enabled = false
                end
            end

            -- 2. Função para otimizar um objeto e seus descendentes
            local function optimizeObject(object)
                if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles") then
                    object.Enabled = false
                elseif object:IsA("Light") then
                    object.Enabled = false
                elseif object:IsA("BasePart") then
                    object.Material = Enum.Material.SmoothPlastic
                    object.Reflectance = 0
                    object.CastShadow = false
                    if object.Parent and object.Parent:FindFirstChildOfClass("Humanoid") then
                        if object.Parent.Humanoid.Health <= 0 then
                            object.CanCollide = false
                        end
                    end
                elseif object:IsA("Decal") or object:IsA("Texture") then
                    object.Transparency = 1
                end
            end

            -- 3. Otimizar tudo o que já existe no Workspace
            for _, descendant in pairs(Workspace:GetDescendants()) do
                optimizeObject(descendant)
            end

            -- 4. Monitorar novos elementos que aparecem na partida
            Workspace.DescendantAdded:Connect(function(descendant)
                task.wait()
                optimizeObject(descendant)
            end)
        end)
    end
})

